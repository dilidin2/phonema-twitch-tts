# ── Model selection ──────────────────────────────────────────────────────
# "gpu_model"  → VoxCPM2 (heavy, requires CUDA/HIP GPU)
# "cpu_model"  → Pocket TTS (light, runs on CPU) — uses a less powerful model for edge devices
model_type: "gpu_model"

# ── VoxCPM2 config (used only when model_type = "gpu_model") ─────────
model:
  pretrained_path: "openbmb/VoxCPM2" # HuggingFace model ID
  dtype: "bfloat16"
  inference_timesteps: 5
  # VoxCPM2 native sample rate
  sr: 48000

  ref_audio_path: "config/reference_voice.wav" # Change this to the actual name of the audio

# ── Pocket TTS config (used only when model_type = "cpu_model") ──────
# Lightweight Kyutai model, runs on CPU with voice cloning and multilingual support
pocket_tts:
  language: "italian_24l"       # "english", "italian_24l", "french_24l", "german_24l", "portuguese_24l", "spanish_24l"
  temperature: 0.7              # sampling (lower = more deterministic)
  lsd_decode_steps: 1           # more steps = better quality but slower (try 5 for high quality)
  eos_threshold: -4.0           # end-of-sequence threshold
  quantize: true                # int8 quantization: less RAM, faster, minimal quality impact

redemption_name: "TTS" # Change with the name of your redemption

voice_rotation:
  mode: "random"
  voices_dir: "config/voices"
  voices:
    # Mix catalog voices (no HF login) and custom files (HF login required)
    # The code automatically detects the type based on the name:
    #   - "giovanni" → built-in catalog voice (NO HF login needed)
    #   - "voice_a.wav" → .wav file in voices_dir (HF login + accepted terms required)
    - "voice_a.wav"
    - "voice_b.wav"
    - "voice_c.wav"
    # Uncomment to add catalog voices:
    # - "giovanni"   # Italian
    # - "alba"       # English
    # - "anna"       # English
    # - "eve"        # English

max_input_chars: 500

queue:
  max_size: 10
  timeout: 30

logging:
  level: "INFO"
  file: "logs/app.log"

host: "127.0.0.1"
port: 8100
